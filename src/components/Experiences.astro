---
import { experiences } from '../data/experiences';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
---
<section id="experiencias" class="experience-section" aria-labelledby="experience-title" data-experiences>
  <div class="experience-heading">
    <p class="section-label">Experiencias</p>
    <h2 id="experience-title" class="editorial-heading">Elige cómo<br /> vivir el valle.</h2>
    <nav class="experience-tabs" aria-label="Tipos de experiencias">
      {experiences.map((item) => <a id={`tab-${item.id}`} href={`#panel-${item.id}`} data-tab={item.id}>{item.label}</a>)}
    </nav>
  </div>
  <div class="experience-panels">
    {experiences.map((item) => <div class="experience-panel" id={`panel-${item.id}`} data-panel={item.id}>
      <figure class="experience-photo">
        <Photo src={item.image} alt={item.alt} />
        <figcaption>{item.caption}<span>Navaluenga · Ávila</span></figcaption>
      </figure>
      <div class="experience-content">
        <h3 class="fallback-heading">{item.label}</h3>
        <p class="experience-intro">{item.intro}</p>
        <ol class="experience-list">
          {item.items.map((entry, i) => <li><a href={entry.href}><span class="item-number">{String(i + 1).padStart(2, '0')}</span><span><strong>{entry.title}</strong><small>{entry.detail}</small></span><Icon name="right" /></a></li>)}
        </ol>
        <a class="button button-sun" href={item.href}>{item.cta} <Icon /></a>
        <p class="experience-note">Consulta la información y las condiciones antes de salir.</p>
      </div>
    </div>)}
  </div>
</section>
<script>
  const section = document.querySelector<HTMLElement>('[data-experiences]');
  if (section) {
    const tablist = section.querySelector<HTMLElement>('.experience-tabs')!;
    const tabs = [...section.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
    const panels = [...section.querySelectorAll<HTMLElement>('[data-panel]')];
    const activate = (index: number, focus = false, sync = false) => {
      tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
      panels.forEach((panel, i) => { panel.hidden = i !== index; });
      if (focus) tabs[index].focus();
      if (sync) history.replaceState({}, '', `#${panels[index].id}`);
    };
    tablist.setAttribute('role', 'tablist');
    tabs.forEach((tab, index) => {
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', panels[index].id);
      panels[index].setAttribute('role', 'tabpanel');
      panels[index].setAttribute('aria-labelledby', tab.id);
      panels[index].tabIndex = 0;
      tab.addEventListener('click', event => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault(); activate(index, false, true);
      });
      tab.addEventListener('keydown', event => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else if (event.key === ' ') next = index;
        else return;
        event.preventDefault(); activate(next, true, true);
      });
    });
    section.dataset.enhanced = 'true';
    const initial = panels.findIndex(panel => `#${panel.id}` === location.hash);
    activate(initial >= 0 ? initial : 0);
    addEventListener('hashchange', () => {
      const index = panels.findIndex(panel => `#${panel.id}` === location.hash);
      if (index >= 0) activate(index);
    });
  }
</script>
