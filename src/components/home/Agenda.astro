---
import Icon from '../Icon.astro';
import { events } from '../../data/municipal';
import { official } from '../../data/site';
const featured = events.slice(0, 3);
---
<section class="home-agenda section-pad" aria-labelledby="home-agenda-title">
  <header class="home-section-heading"><h2 id="home-agenda-title">La vida<br /><em>pasa aquí.</em></h2><div><p>Un encuentro, un paseo, una tarde distinta.<br />Hazle sitio al pueblo en tu calendario.</p><a class="text-link" href="/agenda/">Explorar la agenda <Icon /></a></div></header>
  <p class="home-demo"><strong>Agenda de demostración.</strong> Estos eventos y fechas son ejemplos. <a href={official.agenda}>Consulta la programación oficial <Icon /></a></p>
  <div class="home-event-list">{featured.map(event => <article class="home-event"><time datetime={event.date}><strong>{event.date.slice(-2)}</strong><span>{new Intl.DateTimeFormat('es-ES', { month: 'short', year: 'numeric' }).format(new Date(`${event.date}T12:00:00`))}</span></time><div><p>{event.category} <span aria-hidden="true">/</span> {event.time} · Ejemplo</p><h3><a href={`/agenda/${event.id}/`}>{event.title}</a></h3><span class="event-place">{event.place}</span></div><a class="event-open" href={`/agenda/${event.id}/`} aria-label={`Ver evento de ejemplo: ${event.title}`}><Icon /></a></article>)}</div>
</section>
