---
import Layout from './Layout.astro';
interface Props { title: string; description: string; heading: string; intro?: string; }
const { title, description, heading, intro } = Astro.props;
---
<Layout title={`${title} · Navaluenga`} description={description}>
  <div class="article-shell">
    <nav class="breadcrumbs" aria-label="Migas de pan"><a href="/">Navaluenga</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
    <header class="article-header"><h1>{heading}</h1>{intro && <p>{intro}</p>}</header>
    <slot name="cover" />
    <div class="article-body"><slot /></div>
  </div>
</Layout>
