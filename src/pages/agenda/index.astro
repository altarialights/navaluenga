---
import Shell from '../../components/MunicipalShell.astro';
import DemoNote from '../../components/DemoNote.astro';
import FilterBar from '../../components/FilterBar.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import village from '../../assets/pueblo.jpg';
import { events, eventCategories } from '../../data/municipal';
import { official } from '../../data/site';
---
<Shell title="Agenda municipal" description="Explora una agenda de demostración con calendario mensual, categorías y fichas de actividades. Consulta la programación confirmada en la web oficial.">
  <div class="page-wrap">
    <header class="agenda-mast"><h1>Hay días<br />para encontrarse.</h1><p class="lead">Cultura, caminos y momentos compartidos. La vida del pueblo, en la agenda.</p></header>
    <div class="agenda-feature"><figure><Photo src={village} alt="Vista documental de Navaluenga y las montañas del valle." eager /><figcaption>Navaluenga · Fotografía de contexto, no del evento</figcaption></figure><div class="agenda-feature-copy"><p>24 octubre · Cultura · Ejemplo</p><h2>Una tarde de música en la plaza</h2><p>El mejor plan empieza por salir y encontrarnos.</p><a class="text-link" href="/agenda/musica/">Explorar este evento de ejemplo <Icon /></a></div></div>
    <DemoNote text="Todos los eventos y horarios de esta agenda son ficticios. No constituyen programación municipal confirmada." />
    <a class="text-link" href={official.agenda}>Ver la agenda oficial <Icon /></a>
    <section class="section-space" data-filter-root data-agenda>
      <h2>Encuentra tu próximo plan</h2>
      <FilterBar label="Buscar actividad" categories={eventCategories} />
      <div class="calendar-toolbar"><div class="view-switch" aria-label="Vista de agenda"><button class="quiet-button" data-view="list" aria-pressed="true">Listado</button><button class="quiet-button" data-view="calendar" aria-pressed="false">Calendario</button></div><p class="muted">Fechas de ejemplo · octubre–diciembre 2026</p></div>
      <div data-list>{events.map(event => <article class="event-row" data-item data-category={event.category} data-event-id={event.id}><time class="event-date" datetime={event.date}>{event.date.slice(-2)}<small>{new Date(`${event.date}T12:00:00`).toLocaleDateString('es-ES', { month: 'short' })}</small></time><div><span class="badge">{event.category} · Ejemplo</span><h2><a href={`/agenda/${event.id}/`}>{event.title}</a></h2><p>{event.time} · {event.place}</p></div><a class="text-link" href={`/agenda/${event.id}/`} aria-label={`Ver ${event.title}`}>Ver evento <Icon /></a></article>)}</div>
      <div data-calendar hidden>
        <div class="calendar-toolbar"><button class="quiet-button" data-month-prev aria-label="Mes anterior">Anterior</button><h2 data-month-title aria-live="polite"></h2><button class="quiet-button" data-month-next aria-label="Mes siguiente">Siguiente</button></div>
        <div class="calendar-week" aria-hidden="true">{['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'].map(d => <span>{d}</span>)}</div><div class="calendar-grid" data-calendar-grid></div>
        <p class="small-note" data-month-empty></p>
      </div>
      <noscript><p class="demo-note">El listado está disponible. Para usar filtros y calendario, activa JavaScript.</p></noscript>
    </section>
  </div>
</Shell>
<script>
  import { events } from '../../data/municipal';
  const root = document.querySelector<HTMLElement>('[data-agenda]')!;
  const calendar = root.querySelector<HTMLElement>('[data-calendar]')!;
  const list = root.querySelector<HTMLElement>('[data-list]')!;
  let month = 9, year = 2026;
  const grid = root.querySelector('[data-calendar-grid]')!;
  const render = () => {
    root.querySelector('[data-month-title]')!.textContent = new Intl.DateTimeFormat('es-ES', { month: 'long', year: 'numeric' }).format(new Date(year, month, 1));
    grid.replaceChildren();
    const visibleIds = [...list.querySelectorAll<HTMLElement>('[data-item]')].filter(el => !el.hidden).map(el => el.dataset.eventId);
    const offset = (new Date(year, month, 1).getDay() + 6) % 7;
    const days = new Date(year, month + 1, 0).getDate();
    let count = 0;
    const today = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Madrid' }).format(new Date());
    for (let i = 0; i < Math.ceil((offset + days) / 7) * 7; i++) {
      const cell = document.createElement('div'); cell.className = 'calendar-day';
      const day = i - offset + 1;
      if (day > 0 && day <= days) {
        const date = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const number = document.createElement('span'); number.textContent = String(day); cell.append(number);
        if (date === today) { cell.classList.add('is-today'); number.setAttribute('aria-label', `Hoy, ${day}`); }
        events.filter(e => e.date === date && visibleIds.includes(e.id)).forEach(e => {
          count++; const a = document.createElement('a'); a.href = `/agenda/${e.id}/`; a.textContent = e.title;
          a.setAttribute('aria-label', `${e.title}, ${day} de ${root.querySelector('[data-month-title]')!.textContent}, ${e.time}, ejemplo`); cell.append(a);
        });
      } else cell.setAttribute('aria-hidden', 'true');
      grid.append(cell);
    }
    root.querySelector('[data-month-empty]')!.textContent = count ? `${count} eventos de ejemplo este mes.` : 'No hay eventos con estos filtros en este mes. Puedes cambiar de mes o limpiar los filtros.';
  };
  root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button => button.addEventListener('click', () => {
    const isCalendar = button.dataset.view === 'calendar'; calendar.hidden = !isCalendar; list.hidden = isCalendar;
    root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(b => b.setAttribute('aria-pressed', String(b === button))); render();
  }));
  root.querySelector('[data-month-prev]')!.addEventListener('click', () => { if (--month < 0) { month = 11; year--; } render(); });
  root.querySelector('[data-month-next]')!.addEventListener('click', () => { if (++month > 11) { month = 0; year++; } render(); });
  root.addEventListener('filtered', render); render();
</script>
