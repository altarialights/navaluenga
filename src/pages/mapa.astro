---
import Shell from '../components/MunicipalShell.astro';
import DemoNote from '../components/DemoNote.astro';
import FilterBar from '../components/FilterBar.astro';
import Icon from '../components/Icon.astro';
import { mapPoints, mapCategories } from '../data/municipal';
import { municipality } from '../data/site';
---
<Shell title="Mapa interactivo" description="Explora la cartografía de Navaluenga y prueba filtros y puntos de demostración. Las ubicaciones de los puntos de ejemplo no están verificadas.">
  <div class="page-wrap">
    <header class="map-heading"><h1>Todo un pueblo<br />por descubrir.</h1><p>Elige un tema. Encuentra una nueva perspectiva.<br /><a class="text-link" href={municipality.map}>Buscar Navaluenga en Google Maps <Icon /></a></p></header>
    <DemoNote text="Los nueve puntos y sus coordenadas son ficticios. Sirven para probar la interfaz, no para orientarte ni localizar servicios reales." />
  </div>
  <div class="map-layout" data-map>
    <aside class="map-sidebar" aria-label="Explorar puntos de ejemplo" data-filter-root>
      <FilterBar label="Buscar en el mapa" categories={mapCategories} />
      <div class="map-results">{mapPoints.map((p,i) => <button type="button" data-item data-category={p.category} data-point={p.id} aria-pressed={i === 0}>{p.name}</button>)}</div>
    </aside>
    <div class="map-canvas">
      <div class="map-load" data-map-load><h2>Explora la cartografía</h2><p>Carga el mapa de OpenStreetMap para moverlo y ampliar la vista. Al cargarlo, tu navegador se conectará a ese servicio externo.</p><button class="button button-sun" data-load-map>Cargar mapa interactivo</button></div>
      <iframe title="Mapa OpenStreetMap con punto ficticio de demostración" data-map-frame hidden loading="lazy" referrerpolicy="no-referrer"></iframe>
      <section class="map-card" aria-live="polite"><h2 data-point-title>{mapPoints[0].name}</h2><p data-point-description>{mapPoints[0].description}</p><a class="text-link" data-point-source href={mapPoints[0].source}>Consultar información municipal <Icon /></a><p data-map-status role="status"></p></section>
    </div>
  </div>
  <div class="page-wrap"><p class="small-note">Cartografía © colaboradores de OpenStreetMap. Los datos de ejemplo no son lugares verificados. Si el mapa no carga, utiliza el buscador externo o la información municipal de la ficha.</p><a class="text-link" href="https://www.openstreetmap.org/copyright">Licencia de la cartografía <Icon /></a><noscript><p class="demo-note">La exploración interactiva necesita JavaScript. El enlace «Buscar Navaluenga en Google Maps» sigue disponible.</p></noscript></div>
</Shell>
<script>
  import { mapPoints } from '../data/municipal';
  const root = document.querySelector<HTMLElement>('[data-map]')!;
  const frame = root.querySelector<HTMLIFrameElement>('[data-map-frame]')!;
  const status = root.querySelector('[data-map-status]')!;
  let selected = mapPoints[0], loaded = false;
  let timer: ReturnType<typeof setTimeout>;
  const renderMap = () => {
    if (!loaded) return;
    status.textContent = 'Cargando cartografía externa…';
    const { lat, lon } = selected;
    const params = new URLSearchParams({ bbox: `${lon-.008},${lat-.005},${lon+.008},${lat+.005}`, layer: 'mapnik', marker: `${lat},${lon}` });
    frame.src = `https://www.openstreetmap.org/export/embed.html?${params}`;
    clearTimeout(timer);
    timer = setTimeout(() => { status.textContent = 'Si el mapa no aparece, abre el buscador externo. La lista de puntos sigue disponible.'; }, 12000);
  };
  frame.addEventListener('load', () => { clearTimeout(timer); status.textContent = 'Cartografía externa. Marcador de demostración no verificado.'; });
  root.querySelector('[data-load-map]')!.addEventListener('click', () => {
    loaded = true; root.querySelector<HTMLElement>('[data-map-load]')!.hidden = true; frame.hidden = false; renderMap();
  });
  root.querySelectorAll<HTMLButtonElement>('[data-point]').forEach(button => button.addEventListener('click', () => {
    selected = mapPoints.find(p => p.id === button.dataset.point)!;
    root.querySelectorAll('[data-point]').forEach(b => b.setAttribute('aria-pressed', String(b === button)));
    root.querySelector('[data-point-title]')!.textContent = selected.name;
    root.querySelector('[data-point-description]')!.textContent = selected.description;
    root.querySelector<HTMLAnchorElement>('[data-point-source]')!.href = selected.source;
    renderMap();
  }));
  root.querySelector('[data-filter-root]')!.addEventListener('filtered', () => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-point]')];
    const visible = buttons.filter(b => !b.hidden);
    if (visible.length && !visible.some(b => b.dataset.point === selected.id)) visible[0].click();
    if (!visible.length) { root.querySelector('[data-point-title]')!.textContent = 'Sin puntos con estos filtros'; root.querySelector('[data-point-description]')!.textContent = 'Limpia los filtros para volver a explorar.'; }
    else { root.querySelector('[data-point-title]')!.textContent = selected.name; root.querySelector('[data-point-description]')!.textContent = selected.description; }
  });
</script>
