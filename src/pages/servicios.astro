---
import Article from '../layouts/Article.astro';
import Icon from '../components/Icon.astro';
import { official, municipality, services } from '../data/site';
---
<Article title="Servicios y contacto" heading="Tu ayuntamiento, cerca." description="Accede a la sede electrónica, avisos, agenda y teléfonos municipales de Navaluenga. Contacto del Ayuntamiento y servicios de interés." intro="Los servicios que necesitas, con acceso directo a sus canales oficiales.">
  <section><h2>Encuentra lo que necesitas</h2><ul class="service-links"><li><a href="/tramites/"><span><strong>Guías de trámites</strong><small>Buscador, documentación y orientación.</small></span><Icon /></a></li><li><a href="/vivir/"><span><strong>Vivir en Navaluenga</strong><small>Información para el día a día.</small></span><Icon /></a></li><li><a href="/incidencias/"><span><strong>Tu aviso mejora Navaluenga</strong><small>Prueba el recorrido de incidencias.</small></span><Icon /></a></li><li><a href="/instalaciones/"><span><strong>Instalaciones y reservas</strong><small>Explorador y reserva de demostración.</small></span><Icon /></a></li><li><a href="/contacto/"><span><strong>Atención ciudadana</strong><small>Contacto oficial y orientación.</small></span><Icon /></a></li></ul></section>
  <section><h2>Resuelve tu gestión</h2><ul class="service-links"><li><a href={official.sede}><span><strong>Sede electrónica</strong><small>Trámites, registro y gestiones oficiales.</small></span><Icon /></a></li><li><a href={official.notices}><span><strong>Avisos y tablón de anuncios</strong><small>Consulta las publicaciones municipales vigentes.</small></span><Icon /></a></li><li><a href={official.agenda}><span><strong>Agenda municipal</strong><small>Fechas y programación en la fuente oficial.</small></span><Icon /></a></li></ul></section>
  <section id="telefonos"><h2>Teléfonos a mano</h2><ul class="phone-list">{services.map(service => <li><span>{service.name}</span><a href={`tel:${service.tel}`} aria-label={`Llamar a ${service.name}: ${service.phone}`}>{service.phone} <Icon /></a></li>)}</ul><p class="source-note">Publicados en el <a href={official.services}>listado municipal de servicios</a>. Consulta: 30 de septiembre de 2026.</p></section>
  <section id="contacto"><h2>Contacto municipal</h2><address><p>{municipality.address}</p><p><a href={`tel:${municipality.tel}`}>{municipality.phone}</a></p><p><a href={`mailto:${municipality.email}`}>{municipality.email}</a></p></address><a class="text-link" href={official.contact}>Ver contacto en la web oficial <Icon /></a></section>
  <section><h2>Una idea para el pueblo</h2><p>Las sugerencias tienen su propio espacio. Para solicitudes o trámites administrativos, utiliza la sede electrónica.</p><a class="button button-sun" href="/participa/">Compartir una sugerencia <Icon /></a></section>
</Article>
