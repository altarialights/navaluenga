---
import Shell from '../../components/MunicipalShell.astro';
import Icon from '../../components/Icon.astro';
import { procedures } from '../../data/municipal';
import { official } from '../../data/site';
export function getStaticPaths() { return procedures.map(procedure => ({ params: { id: procedure.id }, props: { procedure } })); }
const { procedure } = Astro.props;
---
<Shell title={procedure.title} description={procedure.description} crumb={`Trámites / ${procedure.title}`}>
  <div class="page-wrap">
    <a href="/tramites/" class="text-link">Todos los trámites</a>
    <header class="page-intro"><h1>{procedure.title}</h1><p class="lead">{procedure.description}</p></header>
    <div class="two-thirds">
      <div><section><h2>Cómo empezar</h2><ol class="guide-list">{procedure.steps.map(step => <li>{step}</li>)}</ol></section><section class="section-space"><h2>Prepara la documentación</h2><ul class="bullet-list">{procedure.documents.map(document => <li>{document}</li>)}</ul><p class="muted">Orientación general. El listado definitivo depende de tu situación y de la ficha oficial del procedimiento.</p></section><section class="section-space faq"><h2>Dudas frecuentes</h2><details><summary>¿Cuál es el plazo y cuánto cuesta?</summary><p>Consulta los plazos, tasas y ordenanzas en la sede oficial. Esta demo no publica importes ni plazos sin verificar.</p></details><details><summary>¿Cómo consulto mi solicitud?</summary><p>Utiliza el canal oficial en el que la presentaste. Conserva el justificante y consulta tus notificaciones.</p></details></section></div>
      <aside class="side-note"><h2>Continúa en la sede</h2><p>Busca «{procedure.title}» en el catálogo oficial y revisa los requisitos antes de presentar tu solicitud.</p><a class="button button-sun" href={official.sede}>Abrir sede oficial <Icon /></a><p class="small-note">Saldrás de esta previsualización. La identificación y la presentación se realizan en la sede municipal.</p><a class="text-link" href="/contacto/">Necesito ayuda <Icon /></a></aside>
    </div>
  </div>
</Shell>
